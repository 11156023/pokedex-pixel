        }
      },
      "id": "2a4c6e8b-0d2f-4c4e-a6b8-7c9e1a3c5e29",
      "name": "回傳 502",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        120
      ]
    }
  ],
