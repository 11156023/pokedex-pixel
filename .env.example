# 複製成 .env 再填（.env 不要上傳）。改完要重啟伺服器。

# 埠號，預設 3000
PORT=3000

# ---- OpenAI：搜尋框名稱比對不到時交給 AI 判斷（「黃色老鼠」→ 皮卡丘）；不填就不用 AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 走相容 OpenAI 格式的代理或其他服務時才改
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-oss／o 系列推理模型可填 low 回得比較快；一般模型（gpt-4o-mini）留空
OPENAI_REASONING_EFFORT=

# ---- n8n：圖鑑頁下方的 n8n 區塊（填 Webhook 節點的 Production URL；workflow 要設成 Active）----
# 本機 n8n 範例：http://localhost:5678/webhook/pokedex
N8N_WEBHOOK_URL=
