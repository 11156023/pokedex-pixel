# 複製成 .env 再填（.env 不要上傳）。改完要重啟伺服器。

# 埠號，預設 3000
PORT=3000

# ---- AI 建議討論：圖鑑頁下方的對話區由誰呼叫 AI ----
# openai（網站直接呼叫）| n8n（轉給 n8n 的 AI flow）| off
# 留空＝自動：有 OPENAI_API_KEY 就用 openai，否則有 N8N_CHAT_WEBHOOK_URL 就用 n8n，都沒有就不顯示
AI_PROVIDER=

# ---- OpenAI（AI_PROVIDER=openai 時用）----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 走相容 OpenAI 格式的代理或其他服務時才改
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-oss／o 系列推理模型可填 low 回得比較快；一般模型（gpt-4o-mini）留空
OPENAI_REASONING_EFFORT=

# ---- n8n AI 建議討論（AI_PROVIDER=n8n 時用；匯入 n8n/pokedex-chat.json，設成 Active 後填 Production URL）----
# 本機 n8n 範例：http://localhost:5678/webhook/pokedex-chat
N8N_CHAT_WEBHOOK_URL=

# ---- n8n 圖鑑卡：圖鑑頁最下面的 n8n 區塊（匯入 n8n/pokedex-webhook.json；跟 AI 建議討論互不影響）----
# 本機 n8n 範例：http://localhost:5678/webhook/pokedex
N8N_WEBHOOK_URL=
