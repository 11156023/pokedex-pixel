# 複製成 .env 再填（.env 不要上傳）。改完要重啟伺服器。

# 埠號，預設 3000
PORT=3000

# ---- 串接：網頁下方的「AI 解說／n8n」區塊用哪一個 ----
# openai | n8n | off；留空＝自動（有 OpenAI 金鑰就用 OpenAI，否則有 n8n 網址就用 n8n，都沒有就不顯示）
ASK_PROVIDER=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 走相容 OpenAI 格式的代理或其他服務時才改
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- n8n（填 Webhook 節點的 Production URL；workflow 要設成 Active）----
# 本機 n8n 範例：http://localhost:5678/webhook/pokedex
N8N_WEBHOOK_URL=
